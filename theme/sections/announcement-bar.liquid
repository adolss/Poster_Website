{%- if section.settings.show -%}
  <div class="announcement">{{ section.settings.text }}</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "show", "label": "Show announcement", "default": true },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Summer drop is here — free shipping on every order, rolled never folded."
    }
  ]
}
{% endschema %}

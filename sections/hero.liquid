{%- liquid
  assign coll = section.settings.collection
  assign cta_url = coll.url | default: routes.all_products_collection_url
  assign featured = section.settings.featured_product
  if featured == blank
    assign featured = all_products['caumasee']
  endif
  assign room = section.settings.room_image | default: featured.images[1]
  assign price_products = coll.products | sort: 'price'
  assign lowest = price_products.first
-%}
<section class="hero">
  <div class="hero-copy">
    <h1>{{ section.settings.heading | escape }}</h1>
    <p class="hero-sub">{{ section.settings.text | escape }}</p>
    <a class="btn btn-primary hero-cta" href="{{ cta_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>
    <p class="hero-note">50 × 70 cm{% if lowest %} · From {{ lowest.price | money_with_currency }}{% endif %}</p>
  </div>
  <figure class="hero-scene">
    {% if room %}
      <img src="{{ room | image_url: width: 1600 }}" srcset="{{ room | image_url: width: 800 }} 800w, {{ room | image_url: width: 1200 }} 1200w, {{ room | image_url: width: 1800 }} 1800w" sizes="(max-width: 760px) 100vw, 68vw" alt="{{ room.alt | default: 'Caumasee poster in a wooden frame in a living room. Styling inspiration; frame not included.' | escape }}" width="{{ room.width }}" height="{{ room.height }}" fetchpriority="high">
    {% else %}<div class="scene-placeholder">Room photograph coming soon</div>{% endif %}
    <figcaption>{{ section.settings.image_caption | escape }}</figcaption>
  </figure>
</section>
{% schema %}
{"name":"Hero","settings":[
{"type":"text","id":"heading","label":"Heading","default":"Places worth keeping."},
{"type":"textarea","id":"text","label":"Text","default":"Swiss places, collected on paper."},
{"type":"text","id":"button_label","label":"Button label","default":"Explore the prints"},
{"type":"collection","id":"collection","label":"Collection"},
{"type":"product","id":"featured_product","label":"Room image from product"},
{"type":"image_picker","id":"room_image","label":"Custom room scene","info":"Optional. Replace with the sideboard scene using the actual poster."},
{"type":"text","id":"image_caption","label":"Image caption","default":"Caumasee, at home."}
],"presets":[{"name":"Hero"}]}
{% endschema %}

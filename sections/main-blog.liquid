<div class="page-main">
  <h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    {%- for article in blog.articles -%}
      <article style="margin-bottom: 28px;">
        <h3 style="margin-bottom: 4px;"><a href="{{ article.url }}" style="color: inherit; text-decoration: none;">{{ article.title }}</a></h3>
        <p class="text-muted" style="font-size: 13px;">{{ article.published_at | date: '%d %B %Y' }}</p>
        <p>{{ article.excerpt_or_content | strip_html | truncate: 160 }}</p>
      </article>
    {%- endfor -%}
    {%- if paginate.pages > 1 -%}{{ paginate | default_pagination }}{%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}

<footer class="site-footer">
  <span class="footer-brand">{{ shop.name }}</span>
  <span class="text-muted">{{ section.settings.tagline }}</span>
  {%- if pages['shipping-faq'] != blank -%}
    <a href="{{ pages['shipping-faq'].url }}">Shipping &amp; FAQ</a>
  {%- endif -%}
  {%- if pages['contact'] != blank -%}
    <a href="{{ pages['contact'].url }}">Contact</a>
  {%- endif -%}
  {%- if pages['about-nordlys'] != blank -%}
    <a href="{{ pages['about-nordlys'].url }}">About Nordlys</a>
  {%- endif -%}
  {%- for policy in shop.policies -%}
    {%- if policy.body != blank -%}
      <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
    {%- endif -%}
  {%- endfor -%}
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Swiss travel posters · 50 × 70 cm · Frames not included"
    }
  ]
}
{% endschema %}

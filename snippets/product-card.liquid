<a class="p-card" href="{{ card_product.url }}">
  <div class="p-card-art">
    {% if card_product.featured_image %}
      <img class="p-card-img" src="{{ card_product.featured_image | image_url: width: 600 }}" srcset="{{ card_product.featured_image | image_url: width: 400 }} 400w, {{ card_product.featured_image | image_url: width: 600 }} 600w, {{ card_product.featured_image | image_url: width: 900 }} 900w" sizes="(max-width: 760px) 44vw, 25vw" alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}" loading="lazy" width="{{ card_product.featured_image.width }}" height="{{ card_product.featured_image.height }}">
    {% else %}<div class="p-card-placeholder">Image coming soon</div>{% endif %}
  </div>
  <div class="p-meta"><span class="p-name">{{ card_product.title | escape }}</span><span class="p-price">{% if card_product.price_varies %}From {% endif %}{{ card_product.price | money_with_currency }}</span></div>
  <p class="p-sub text-muted">50 × 70 cm{% unless card_product.available %} · Sold out{% endunless %}</p>
</a>
